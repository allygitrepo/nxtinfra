<script type="text/javascript">

var table;

$(document).ready(function() {
    //datatables
    table = $('#table').DataTable({ 

        "processing": true, //Feature control the processing indicator.
        "serverSide": true, //Feature control DataTables' server-side processing mode.
        "order": [], //Initial no order.

        // Load data for the table's content from an Ajax source
        "ajax": {
            "url": "<?php echo site_url('configrations/ajax_company_list')?>",
            "type": "POST",
            "data": function ( data ) {
            }
        },

        //Set column definition initialisation properties.
        "columnDefs": [
        { 
            "targets": [ 0 ], //first column / numbering column
            "orderable": false, //set not orderable
        },
        ],
		drawCallback: function() {}
    });

    $('#btn-filter').click(function(){ //button filter event click
        table.ajax.reload();  //just reload table
    });
});

</script> 
<script>

function edit_fn(id){
	var master_typea=$('#master_type_'+id).val();
	var master_name=$('#master_name_'+id).val();
	
	 $('#edit_name').val(master_name);
	 $('#edid_id').val(id);
	 $("#mt").val(master_typea).change();
	}
	
function update(){
    var edit_name= encodeURIComponent($('#edit_name').val());
	var edid_id= encodeURIComponent($('#edid_id').val());
	var mt=  $("#mt").val();
    var dataString = 'action=ajax_update_master&edit_name='+edit_name+'&edid_id='+edid_id+'&mt='+mt;
		 $.ajax({
              type: "POST",
              url: "<?php echo site_url('master/ajax_update_master')?>",             
			  data: dataString,
              cache: false,
                success: function (data) {
					if(data==0){Swal.fire('Oops...','Duplicate Master not allowed','error');}
					else{table.ajax.reload(); 
					$('#editmodel').modal('hide');
					Swal.fire('Good job!','Master Updated','success');
				   }
                },
            });
		}
	

</script>